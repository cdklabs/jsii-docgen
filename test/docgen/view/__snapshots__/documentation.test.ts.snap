\`\`\`csharp
using Amazon.CDK;

new HelmChartOptions {
    string Chart,
    bool CreateNamespace = null,
    string Namespace = null,
    string Release = null,
    string Repository = null,
    Duration Timeout = null,
    System.Collections.Generic.IDictionary<string, object> Values = null,
    string Version = null,
    bool Wait = null
};
