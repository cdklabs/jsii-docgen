from aws_cdk import aws_eks

aws_eks.KubernetesPatch(
  scope: Construct,
  id: str,
  apply_patch: typing.Mapping[typing.Any],
  cluster: ICluster,
  resource_name: str,
  restore_patch: typing.Mapping[typing.Any],
  patch_type: PatchType = None,
  resource_namespace: str = None
)
