//  .coreDnsComputeType(CoreDnsComputeType)
//  .endpointAccess(EndpointAccess)
//  .kubectlEnvironment(java.util.Map<java.lang.String, java.lang.String>)
//  .kubectlLayer(ILayerVersion)
