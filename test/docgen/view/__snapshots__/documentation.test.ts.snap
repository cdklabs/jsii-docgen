### FargateClusterProps <a name="FargateClusterProps" id="monocdk.aws_eks.FargateClusterProps"></a>

Configuration props for EKS Fargate.

#### Initializer <a name="Initializer" id="monocdk.aws_eks.FargateClusterProps.Initializer"></a>

\`\`\`go
import "github.com/aws/aws-cdk-go/awscdk/awseks"

&awseks.FargateClusterProps {
	Version: github.com/aws/aws-cdk-go/awscdk.aws_eks.KubernetesVersion,
	ClusterName: *string,
	OutputClusterName: *bool,
	OutputConfigCommand: *bool,
	Role: github.com/aws/aws-cdk-go/awscdk.aws_iam.IRole,
	SecurityGroup: github.com/aws/aws-cdk-go/awscdk.aws_ec2.ISecurityGroup,
	Vpc: github.com/aws/aws-cdk-go/awscdk.aws_ec2.IVpc,
	VpcSubnets: *[]github.com/aws/aws-cdk-go/awscdk.aws_ec2.SubnetSelection,
	ClusterHandlerEnvironment: *map[string]*string,
	CoreDnsComputeType: github.com/aws/aws-cdk-go/awscdk.aws_eks.CoreDnsComputeType,
	EndpointAccess: github.com/aws/aws-cdk-go/awscdk.aws_eks.EndpointAccess,
	KubectlEnvironment: *map[string]*string,
	KubectlLayer: github.com/aws/aws-cdk-go/awscdk.aws_lambda.ILayerVersion,
	KubectlMemory: github.com/aws/aws-cdk-go/awscdk.Size,
	MastersRole: github.com/aws/aws-cdk-go/awscdk.aws_iam.IRole,
	OutputMastersRoleArn: *bool,
	PlaceClusterHandlerInVpc: *bool,
	Prune: *bool,
	SecretsEncryptionKey: github.com/aws/aws-cdk-go/awscdk.aws_kms.IKey,
	DefaultProfile: github.com/aws/aws-cdk-go/awscdk.aws_eks.FargateProfileOptions,
}
\`\`\`

