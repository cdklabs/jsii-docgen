//  .mastersRole(IRole)
//  .outputMastersRoleArn(java.lang.Boolean)
//  .placeClusterHandlerInVpc(java.lang.Boolean)
//  .prune(java.lang.Boolean)
//  .secretsEncryptionKey(IKey)
    .build();
\`\`\`

